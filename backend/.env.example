APP_NAME=FastAPI Admin Backend
APP_HOST=0.0.0.0
APP_PORT=3101
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://admin:password123@127.0.0.1:5433/admin_system
ACCESS_TOKEN_TTL_SECONDS=86400
CAPTCHA_TTL_SECONDS=300
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_PROCESSING_MODE=worker
DOCUMENT_CHUNK_SIZE=800
DOCUMENT_CHUNK_OVERLAP=120
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_FALLBACK_TO_HASH=true
EMBEDDING_VECTOR_SIZE=384
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=document_chunks
RETRIEVAL_DEFAULT_LIMIT=8
RETRIEVAL_CANDIDATE_LIMIT=24
RETRIEVAL_KEYWORD_WEIGHT=0.22
RETRIEVAL_EXACT_MATCH_BONUS=0.08
RAG_ANSWER_MAX_CHUNKS=4
RAG_ANSWER_MAX_CONTEXT_CHARS=2400
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=60
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=admin-system
MINIO_SECURE=false
MINIO_CONSOLE_URL=http://127.0.0.1:9001
